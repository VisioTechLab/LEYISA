{
  "name": "leyisa-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:check-connection": "node --env-file-if-exists=../.env scripts/check-db-connection.mjs",
    "db:verify": "node --env-file-if-exists=../.env scripts/verify-db.mjs",
    "build": "npm run db:generate && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "db:check-access": "node --env-file-if-exists=../.env scripts/check-db-access.mjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.9",
    "@nestjs/core": "11.2.9",
    "@nestjs/platform-express": "11.2.9",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prisma": "7.8.0",
    "typescript": "5.9.3"
  }
}
