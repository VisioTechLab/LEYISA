# Valeurs d'exemple uniquement. Aucun secret réel dans ce fichier.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
APP_ORIGINS=https://demo.example.invalid
LEYISA_DB_MODE=shared
# DATABASE_URL : compte runtime limité, URL pooled TLS, injectée par le coffre.
# DIRECT_DATABASE_URL : propriétaire direct, seulement dans le job de migration approuvé.
# Aucune migration ni aucun seed ne s'exécute au démarrage du serveur.
