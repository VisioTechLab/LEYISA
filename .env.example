# Exemple réservé au PostgreSQL local de développement. Ne pas versionner .env.
POSTGRES_USER=leyisa
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_DB=leyisa
POSTGRES_PORT=5432
# Reporter les valeurs ci-dessus (encoder les caractères réservés dans l'URL).
DATABASE_URL=postgresql://leyisa:replace_with_a_local_password@127.0.0.1:5432/leyisa

# Pour Neon, sélectionner shared et remplacer DATABASE_URL par l'URL pooled du compte limité.
# DIRECT_DATABASE_URL est renseignée seulement par Kevin dans son environnement de migration.
LEYISA_DB_MODE=local
DIRECT_DATABASE_URL=
